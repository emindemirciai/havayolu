# ucus-takip — ortam değişkenleri
#
# Bu dosya BÜTÜN parçaların değişkenlerini baştan listeler (D-027): Dokploy Environment
# sekmesine hepsini bir kez gir; henüz kullanılmayanlar boş kalabilir. Her değişkenin
# yanında hangi parçada kullanıldığı yazar.
#
# Yerel geliştirme: pnpm dev bu dosyayı sır olmayan varsayılanlar olarak okur. Kendi
# değerlerin için kökte .env oluştur (git'e girmez); .env buradaki değerleri ezer.
# Üretim: değerler Dokploy'dan gelir. Sırları parola yöneticisinde üret ve yalnızca
# [A-Za-z0-9_-] karakterlerini kullan (Docker Compose "$" işaretini yorumlar).

# ── Genel (Parça 1) ────────────────────────────────────────────────────────────
# development | test | production
APP_ENV=development
# Ürün adı; boşsa kod adı "ucus-takip" gösterilir.
APP_NAME=
# adsb.lol User-Agent'ında ve yasal metinlerde kullanılan iletişim adresi.
# Boşsa canlı veri çekimi (ingest) başlamaz.
CONTACT_EMAIL=
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# commercial: ticari kullanıma kapalı veri sağlayıcısı başlatılamaz.
DATA_USAGE_MODE=commercial
# true: adsb.lol, OurAirports, VRS, aviationweather, OpenFreeMap ve Turnstile'a
# canlı istek atılmaz (CI, testler, yerel geliştirme). Üretimde false.
EXTERNAL_PROVIDERS_DISABLED=true

# ── Host'lar ve URL'ler (Parça 1) ──────────────────────────────────────────────
# Genel alan adları (şemasız). Üretimde örn. ucus.ornek.com, ucus-api.ornek.com.
WEB_HOST=localhost:3100
API_HOST=localhost:4100
ADMIN_HOST=
# Web sunucusunun API'ye iç ağdan ulaştığı adres. Üretimde http://ut-api:4000.
API_INTERNAL_URL=http://localhost:4100

# ── Portlar ────────────────────────────────────────────────────────────────────
# API_PORT boşsa: üretimde 4000 (konteyner), yerelde 4100. Web yerelde 3100'de açılır
# (3000–3003 bu makinede başka projenin); konteynerde 3000'dir.
API_PORT=
API_LISTEN_HOST=0.0.0.0
WORKER_HEALTH_PORT=4200

# ── Veritabanı ve Redis (Parça 1 M1a) ──────────────────────────────────────────
# Yerel değerler docker-compose.dev.yml içindir; üretimde güçlü parolalar kullan.
POSTGRES_USER=ucus
POSTGRES_PASSWORD=ucus_dev_only
POSTGRES_DB=app_dev
DATABASE_URL=postgres://ucus:ucus_dev_only@localhost:55432/app_dev
REDIS_QUEUE_PASSWORD=queue_dev_only
REDIS_LIVE_PASSWORD=live_dev_only
REDIS_QUEUE_URL=redis://:queue_dev_only@localhost:56379/0
REDIS_LIVE_URL=redis://:live_dev_only@localhost:56380/0

# ── Yönetici (Parça 1 M1a) ─────────────────────────────────────────────────────
# Admin paneli ve analiz paneli girişinde kullanılan e-posta.
ADMIN_EMAIL=
# En az 32 karakterlik rastgele anahtar; boşsa yönetici girişi kapalıdır.
# Parça 2B'de gerçek admin hesabı oluşunca devre dışı kalır.
ADMIN_SETUP_TOKEN=

# ── Ağ ve güvenlik (Parça 1 M1a) ───────────────────────────────────────────────
# Fastify'ın güveneceği proxy ağları (Traefik), virgülle ayrılmış CIDR listesi.
TRUSTED_PROXY_CIDRS=
# Cloudflare proxy kullanılıyorsa "cloudflare" (istemci IP'si CF-Connecting-IP'den okunur).
EDGE_PROXY=

# ── Canlı veri (Parça 1 M3–M4) ─────────────────────────────────────────────────
# adsb.lol istek hızı (istek/sn). Başlangıç 0.1, üst sınır 0.2 (D-031).
ADSBLOL_RPS=0.1
# adsb.lol ileride anahtar isterse (besleyiciye verilir); şimdilik boş.
ADSBLOL_API_KEY=
ADSBLOL_API_KEY_HEADER=
# Kendi readsb/tar1090 alıcıların (virgülle ayrılmış aircraft.json adresleri). Opsiyonel.
LOCAL_RECEIVER_URLS=
# Parça 2'ye kadar takip listesinin yerine geçen hex listesi (virgülle).
WATCH_HEX_LIST=
TRACK_SAMPLED_RETENTION_DAYS=7
TRACK_FINE_RETENTION_DAYS=30
WS_MAX_CONNECTIONS=2000

# ── Harita (Parça 1 M6) ────────────────────────────────────────────────────────
MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty
MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark
MAP_STYLE_FALLBACK_URL=

# ── Analiz: Siteni Analiz Et (Parça 1 M1a) ─────────────────────────────────────
# Analiz uygulamasının adresi (örn. https://ucus-analiz.ornek.com) ve data-site değeri.
# İkisi de doluysa ve kullanıcı onay verdiyse takip script'i yüklenir.
ANALYTICS_URL=
ANALYTICS_SITE_ID=

# ── Bildirimler (Parça 2) ──────────────────────────────────────────────────────
# VAPID anahtarlarını sen üretirsin: pnpm vapid:generate (parola yöneticisine yedekle).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# mailto:adres ya da https URL; localhost olamaz.
VAPID_SUBJECT=
# Expo push "enhanced security" erişim token'ı.
EXPO_ACCESS_TOKEN=

# ── Hesaplar ve e-posta (Parça 2B) ─────────────────────────────────────────────
# Yerelde Mailpit: smtp://localhost:51025
SMTP_URL=smtp://localhost:51025
SMTP_FROM=
# JWT imza anahtarı (en az 32 karakter).
JWT_SIGNING_KEY=
# Dev'de boş (host-only çerez).
COOKIE_DOMAIN=
REGISTRATION_ENABLED=false
# Kayıt kapalıyken kaydolabilecek e-postalar (test kullanıcıları), virgülle.
REGISTRATION_ALLOWLIST=

# ── Bot koruması (Parça 3, opsiyonel) ──────────────────────────────────────────
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Yedek ve gözlem (Parça 2 M9) ───────────────────────────────────────────────
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
HEARTBEAT_URL_INGEST=
HEARTBEAT_URL_NOTIFIER=
HEARTBEAT_URL_BACKUP=
SENTRY_DSN=
# /metrics uç noktasını koruyan token.
METRICS_TOKEN=

# ── Yayın ve kaynaklar (Parça 1 M1a; docker-compose.yml) ───────────────────────
# GHCR imaj etiketi: main ya da sha-<7>. Geri almada değiştirilir.
IMAGE_TAG=main
# İmaja build sırasında gömülür; yerelde "dev".
GIT_SHA=dev
MEM_LIMIT_POSTGRES=768m
MEM_LIMIT_REDIS_QUEUE=256m
MEM_LIMIT_REDIS_LIVE=256m
MEM_LIMIT_WEB=320m
MEM_LIMIT_API=384m
MEM_LIMIT_WORKER_RT=384m
MEM_LIMIT_WORKER_BG=256m
