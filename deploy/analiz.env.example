############################################
# ANALIZ (Siteni Analiz Et) - PRODUCTION
# Dokploy → ayrı Compose uygulaması → Environment
############################################
# Repo: https://github.com/emindemirciai/Analyze.Your.Site-Siteni-Analiz-Et- (servis "analyze",
# port 3000, domain analiz.havayolu.live). Anahtarlar o reponun .env.example'ından alınmıştır.
# Giriş havayolu API'sinin platform-admin sözleşmesiyle yapılır (infra.md → Analiz).

NODE_ENV=production

ANALYZE_SITE_ID=havayolu.live
ANALYZE_SITE_NAME=havayolu.live
ANALYZE_TITLE_TR=havayolu Siteni Analiz Et
ANALYZE_TITLE_EN=havayolu Analyze Your Site
ANALYZE_METADATA_TITLE=havayolu Siteni Analiz Et | Trafik Paneli
ANALYZE_DESCRIPTION=havayolu.live için gerçek zamanlı trafik analiz paneli
ANALYZE_HEALTH_NAME=havayolu Siteni Analiz Et

ANALYZE_AUTH_MODE=platform-admin
ANALYZE_AUTH_API_URL=https://api.havayolu.live

# www.havayolu.live köke yönlendiği için olaylar kökten gelir; www yedek olarak durur.
ANALYZE_ALLOWED_ORIGINS=https://havayolu.live,https://www.havayolu.live
ANALYZE_EVENT_SITES=havayolu.live,www.havayolu.live

ANALYZE_DATA_DIR=/app/data
# Paylaşılan VPS'te bellek için düşük tutulur (uygulamanın varsayılanı 100000).
ANALYZE_MAX_EVENTS=20000
# ip-api.com ücretsiz katmanı ticari kullanıma kapalı ve HTTP'dir (KVKK); kapalı kalır.
ANALYZE_GEO_LOOKUP=false
